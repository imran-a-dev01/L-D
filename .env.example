# NEXUS L&D — Environment Configuration
# Copy this file to .env and fill in the values before starting the server.

# Authentication required flag (default: false for public dual-page mode)
# Set to true to enforce JWT authentication and RBAC permissions.
AUTH_REQUIRED=false

# Required only when AUTH_REQUIRED=true: Secret key for signing JWT tokens.
# Example: openssl rand -base64 48
JWT_SECRET=nexus_ld_super_secret_jwt_key_2026

# Server network binding (default: 127.0.0.1 for local only, 0.0.0.0 to expose on network)
# CAUTION: If HOST=0.0.0.0, set AUTH_REQUIRED=true before exposing beyond trusted network.
HOST=127.0.0.1

# Server port (default: 3001)
PORT=3001

# CORS allowed origin for Vite frontend (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Allow full database reset via POST /api/employees/reset (default: false)
ALLOW_SYSTEM_RESET=false

# Node environment
NODE_ENV=development
