# NEXUS L&D — Environment Configuration
# Copy this file to .env and fill in the values before starting the server.
# On Azure App Service, set these in Configuration > Application Settings instead.

# Authentication required flag (default: false for local dev)
# PRODUCTION: Set to true to enforce JWT authentication and RBAC permissions.
AUTH_REQUIRED=false

# Secret key for signing JWT tokens.
# PRODUCTION: Generate a strong secret: openssl rand -base64 48
JWT_SECRET=nexus_ld_super_secret_jwt_key_2026

# Server network binding (default: 127.0.0.1 for local only, 0.0.0.0 to expose on network)
HOST=127.0.0.1

# Server port (default: 3001, Azure uses PORT=8080 automatically)
PORT=3001

# CORS allowed origin for Vite frontend (default: http://localhost:5173)
# PRODUCTION: Not needed if API + UI are served from same domain (single-process mode)
CORS_ORIGIN=http://localhost:5173

# SQLite database file path (default: server/db/nexus_ld.sqlite)
# PRODUCTION on Azure: /home/data/nexus_ld.sqlite (persistent storage)
# DATABASE_PATH=/home/data/nexus_ld.sqlite

# Allow full database reset via POST /api/employees/reset (default: false)
# PRODUCTION: Always keep false
ALLOW_SYSTEM_RESET=false

# Node environment
NODE_ENV=development
